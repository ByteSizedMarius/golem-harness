# Golem harness settings.
#
# start.sh sources this file as .env and folds it into the environment. bot.js and
# the MCP server read only their process environment, so any other launch needs
# the variables exported in the shell that starts it, for example:
#   GOLEM_TOKEN=<token> MC_PORT=25565 node bot.js

# --- Required ---------------------------------------------------------------

# The key that signs every request to the control API and every reply. At least
# 32 characters, otherwise the bot refuses to start. The MCP server (mcp/server.js)
# needs the same value in its environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOLEM_TOKEN=

# --- Minecraft connection ---------------------------------------------------

# Host of the world or server.
MC_HOST=localhost

# Port of the world. A LAN world prints it in chat on Open to LAN and gets a
# new one on every re-open. 25565 is the default of a dedicated server.
MC_PORT=25565

# Minecraft version to speak. "auto" takes it from the server handshake. When
# the variable is unset the bot speaks 1.21.11.
# mineflayer lags new Minecraft releases. A world newer than the library
# supports (for example a year-scheme version like 26.2) fails at login with
# any value here.
MC_VERSION=auto

# The bot's in-game username (offline-mode login).
MC_USER=Claude

# --- Local ports ------------------------------------------------------------

# Control API port. It binds 127.0.0.1 only, there is no setting for the host.
CTRL_PORT=3000

# --- Optional ---------------------------------------------------------------

# Player that the /where route reports when a request carries no name. The
# where tool always sends a name.
MC_OWNER=

# Set to 1 for a Forge 1.7.10 server behind ViaProxy: no attack charge, a sword
# block instead of a shield, no off-hand.
GOLEM_MC_1710=

# The longest chat line the server takes, 100 to 256. Empty means 100. A
# 1.7.10 server through ViaProxy takes 256 only with hodgepodge's longerSentMessages on
# and a plugin that lifts ViaVersion's cut at 100.
GOLEM_CHAT_MAX=

# JSON file of recipe and block-name overrides, read at start. Empty means none.
#   {"ingredients": {"stick": {"items": ["stick"]}},
#    "recipes": [{"item": "oak_fence", "count": 2,
#                 "inShape": [["stick", "stick", "stick"], ["stick", "stick", "stick"]]}],
#    "blocks": {"end_rod": "gravestone"}}
# A listed item crafts only by its override. null in inShape is an empty cell.
# A block renamed to gravestone enables the grave tool.
GOLEM_SERVER_OVERRIDES=

# Files the MCP server appends to, each an absolute path. Empty turns the tool
# off, and it answers that it is off.
# papercut: notes on what made playing harder than it should be.
GOLEM_PAPERCUTS=
# lesson: what a future player should know, for the owner to fold into the manual.
GOLEM_LESSONS=
# todo: the pilot's todo list. It is read and rewritten, kept across restarts
# and shown at boot.
GOLEM_TODO=
